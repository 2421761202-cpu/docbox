{
  "name": "docbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "免费的在线图片与 PDF 处理工具 —— 全部在浏览器本地完成，文件不上传服务器",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4180",
    "serve": "node scripts/serve-dist.mjs",
    "serve:lan": "node scripts/serve-dist.mjs --lan",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs && node --import ./scripts/register-ts.mjs scripts/smoke-pdf.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
